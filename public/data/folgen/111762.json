{"f":[[1,"-"],[2,"Oder iss Nudeln mit deinen Freunden"],[3,"Darf ich dich umziehen?"],[4,"Sie hat mich abserviert…"],[5,"Wartet auf mich, Tororo-Soba!"],[6,"Bist du wirklich so dumm?"],[7,"Spielen wir Wassermelonenschlagen!"],[8,"Weil es wahr ist"],[9,"Meine kostbare…"],[10,"Wer bist du?"],[11,"Nur mir ganz allein"],[12,"Statt mir hast du geweint"],[13,"Geht klar"],[14,"Dann kann ich auch sterben…"],[15,"Bis später!"],[16,"Kannst du ihm das sagen?"],[17,"Die gibt es bestimmt..."],[18,"Wollen wir uns küssen?"],[19,"Es gibt keinen!"],[20,"Alles in Ordnung?"],[21,"Es gab ihn wirklich"],[22,"Ich will das nicht!"],[23,"Aschenputtel oder so was in der Art!"],[24,"Du bist hier, Machi"],[25,"Ich bin jetzt anders"]],"de":[[1,25]],"min":24}