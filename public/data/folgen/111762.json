[[1,24,"-"],[2,24,"Oder iss Nudeln mit deinen Freunden"],[3,24,"Darf ich dich umziehen?"],[4,24,"Sie hat mich abserviert…"],[5,24,"Wartet auf mich, Tororo-Soba!"],[6,24,"Bist du wirklich so dumm?"],[7,24,"Spielen wir Wassermelonenschlagen!"],[8,24,"Weil es wahr ist"],[9,24,"Meine kostbare…"],[10,24,"Wer bist du?"],[11,24,"Nur mir ganz allein"],[12,24,"Statt mir hast du geweint"],[13,24,"Geht klar"],[14,24,"Dann kann ich auch sterben…"],[15,24,"Bis später!"],[16,24,"Kannst du ihm das sagen?"],[17,24,"Die gibt es bestimmt..."],[18,24,"Wollen wir uns küssen?"],[19,24,"Es gibt keinen!"],[20,24,"Alles in Ordnung?"],[21,24,"Es gab ihn wirklich"],[22,24,"Ich will das nicht!"],[23,24,"Aschenputtel oder so was in der Art!"],[24,24,"Du bist hier, Machi"],[25,24,"Ich bin jetzt anders"]]