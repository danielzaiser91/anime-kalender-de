[[1,24,"Hab ich mich etwa in sie verwandelt?!"],[2,24,"Küss mich!"],[3,24,"Nimmst du an? Oder nicht?"],[4,24,"Ich glaube, ich hab mich in Yamada verliebt!"],[5,24,"Du darfst sie nicht küssen, klar?"],[6,24,"Antworte!"],[7,24,"Bloß nicht Tempura!"],[8,24,"Du nervst gewaltig!"],[9,24,"Du musst die Zukunft ändern!"],[10,24,"Geh bitte mit mir aus!"],[11,24,"Wo hast du Shiraishi versteckt?!"],[12,24,"Ich liebe dich, Shiraishi!"]]