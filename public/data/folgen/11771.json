{"f":[[1,"Ich bin Kuroko"],[2,"Ich meine es ernst"],[3,"Es ist besser, wenn ich nicht gewinnen kann"],[4,"Hoff du magst meinen Gegenangriff!"],[5,"Dein Basketball"],[6,"Lass mich dir zwei Dinge erklären"],[7,"Du wirst etwas einmaliges sehen"],[8,"Jetzt, da ich daran denke"],[9,"Gewinnen"],[10,"Ich kann das nicht haben"],[11,"Das ist es nicht"],[12,"Was ist &quot;Sieg&quot;"],[13,"Ich habe an dich geglaubt"],[14,"Du siehst aus wie er"],[15,"Das ich nicht lache"],[16,"Auf gehts"],[17,"Ihr seid alle Lächerlich!"],[18,"Nein!!"],[19,"Auf zu einer neuen Herausforderung"],[20,"Ich will nicht so sein"],[21,"Lasst und anfangen"],[22,"Ich werde gewinnen, auch wenn es mich umbringt."],[23,"Nicht erwachsen"],[24,"Versteh' das nicht falsch"],[25,"Unser Basketball"]],"de":[[1,25]],"min":24}