[[1,24,"Manchmal reicht eine winzige Kleinigkeit."],[2,24,"Unterschiedliche Gesichter"],[3,24,"Es ist alles okay."],[4,24,"Jeder hat jemanden, den er mag."],[5,24,"Das kann ich nicht sagen."],[6,24,"Dieser Sommer ist sehr heiß."],[7,24,"Ich werde sein, wo du bist."],[8,24,"Was Lügen offenbaren."],[9,24,"Schwierig, aber nicht unmöglich."],[10,24,"Eines Tages, wenn der Schnee geschmolzen ist."],[11,24,"Was sich liebt, das neckt sich."],[12,24,"Bis jetzt und für immer"],[13,24,"Wenigsten diesen weiten Himmel..."]]