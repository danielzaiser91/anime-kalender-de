[[1,24,"Ippon!"],[2,24,"Gründung! Reaktivierung! Wiederbelebung!"],[3,24,"Sie kann die Stimmungen verändern"],[4,24,"Keine Sorge, wir sind zu dritt!"],[5,24,"Judo fühlt sich fantastisch an"],[6,24,"Weil ich nichts bereuen will"],[7,24,"Unser Senpai, die Geheimwaffe"],[8,24,"Der Traum geht weiter"],[9,24,"Cleverness siegt über Kraft"],[10,24,"Wir wollen gewinnen - was sonst?"],[11,24,"Das goldene Zeitalter"],[12,24,"Ich bin so stark wie nie zuvor"],[13,24,"Ippon Again!"]]