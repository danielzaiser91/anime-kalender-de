{"f":[[1,"Ippon!"],[2,"Gründung! Reaktivierung! Wiederbelebung!"],[3,"Sie kann die Stimmungen verändern"],[4,"Keine Sorge, wir sind zu dritt!"],[5,"Judo fühlt sich fantastisch an"],[6,"Weil ich nichts bereuen will"],[7,"Unser Senpai, die Geheimwaffe"],[8,"Der Traum geht weiter"],[9,"Cleverness siegt über Kraft"],[10,"Wir wollen gewinnen - was sonst?"],[11,"Das goldene Zeitalter"],[12,"Ich bin so stark wie nie zuvor"],[13,"Ippon Again!"]],"de":[],"min":24}