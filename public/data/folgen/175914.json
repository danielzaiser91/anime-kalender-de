[[1,23,"Das ist nicht unsere Zeit"],[2,23,"Ich habe dich gesucht"],[3,23,"In Geisterhäusern gibt’s keine Geister"],[4,23,"Willst du rennen können?"],[5,23,"Die mit dir verbrachten Jahre"],[6,23,"Ich red nicht von der Qualität!"],[7,23,"Dafür bist du zu dumm, Nanakusa"],[8,23,"Du bist die Erste, Senpai"],[9,23,"Was willst du tun, Yamori?"],[10,23,"Dann wenigstens von dir"],[11,23,"Mwah!"],[12,23,"Call of the Night"]]