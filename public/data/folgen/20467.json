[[1,24,"Illya wird erwachsen?!"],[2,24,"Illya × Illya"],[3,24,"Du zerstörst mein Leben!"],[4,24,"Eine stürmische Neue"],[5,24,"Das bedeutet …"],[6,24,"Lügen und die Wahrheit hinter der starken Fassade"],[7,24,"Konfrontation! Die Cooking Sisters!"],[8,24,"Ihr Name lautet …"],[9,24,"Ein einsamer Kampf"],[10,24,"Was du mit deinen Händen beschützt hast"]]