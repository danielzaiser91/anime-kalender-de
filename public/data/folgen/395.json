{"f":[[1,"Lebewohl",0],[2,"Ich möchte sofort dorthin!",0],[3,"Ich mache das!",0],[4,"Ich kann sie erschießen, oder?",0],[5,"Willkommen zurück",0],[6,"Was zum Teufel ist das?",0],[7,"Bitte erschieß mich!",0],[8,"Großer Bruder?",0],[9,"Sagen Sie das nie wieder!",0],[10,"Kurono Alien",0],[11,"Es gibt kein Labyrinth, aus dem man nicht entfliehen kann!",0],[12,"Lasst uns lebend zurückkehren",0],[13,"Bitte lebe!",0]],"de":[[1,13]]}