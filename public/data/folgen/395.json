{"f":[[1,"Lebewohl"],[2,"Ich möchte sofort dorthin!"],[3,"Ich mache das!"],[4,"Ich kann sie erschießen, oder?"],[5,"Willkommen zurück"],[6,"Was zum Teufel ist das?"],[7,"Bitte erschieß mich!"],[8,"Großer Bruder?"],[9,"Sagen Sie das nie wieder!"],[10,"Kurono Alien"],[11,"Es gibt kein Labyrinth, aus dem man nicht entfliehen kann!"],[12,"Lasst uns lebend zurückkehren"],[13,"Bitte lebe!"]],"de":[[1,13]],"min":23}