[[1,24,"Drachenpilotin?"],[2,24,"Ich nenne den Drachen Masotan"],[3,24,"Würdest du bitte Verantwortung übernehmen?"],[4,24,"Diese Leute sind nach Gifu gekommen"],[5,24,"Wer mag es, nicht gemocht zu werden?"],[6,24,"Ich werde deinen Namen rufen"],[7,24,"Königreich der Liebe"],[8,24,"Limitierte Auflage! Würziger Omi-Geschmack"],[9,24,"Iiiiiiiiiih!"],[10,24,"Erweichende Liebe"],[11,24,"Montparnasses Himmel und das Dreckstück"],[12,24,"Wir sind unbesiegbar"]]