[[1,24,"Töte mich ... bitte."],[2,24,"Dies ist nicht dein Grab."],[3,24,"Ich schwöre bei Gott."],[4,24,"Keine Wahl für Sünder."],[5,24,"Ich will dich (noch nicht) töten."],[6,24,"Nur Zack darf mich richten."],[7,24,"Wer bist du?"],[8,24,"Ja ..., ich bin ein Monster."],[9,24,"Es gibt keinen Gott."],[10,24,"Der Hexenprozess beginnt."],[11,24,"Weil du mein Erlöser bist, Zack."],[12,24,"Erkenne die Wahrheit."]]