{"f":[[1,"Ich brauche dich",30],[2,"Eine Hand reicht",25],[3,"Ich hab den Beweis!",25],[4,"Komm schon, Akira",25],[5,"Wunderschöne Silene",25],[6,"Weder Dämon, noch Mensch",25],[7,"Schwache Menschen, schlaue Dämonen",25],[8,"Wer bin ich?",25],[9,"Fahrt zur Hölle, Sterbliche!",25],[10,"Heulsuse",25]],"de":[[1,10]]}