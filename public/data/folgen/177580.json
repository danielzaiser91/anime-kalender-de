[[1,24,"Wollen wir Freunde sein?"],[2,24,"Ich will bei dir sein"],[3,24,"Ich lass mich nicht unterkriegen!"],[4,24,"Die Quelle meiner guten Laune"],[5,24,"Irgendwer hat mich auf dem Kieker"],[6,24,"Mein Bruder ist hier!"],[7,24,"Ich bin ein Junge, klar?!"],[8,24,"Wir werden nicht zusammenkommen"],[9,24,"Kann es so bleiben?"],[10,24,"Frauenkleider stehen mir nicht"],[11,24,"Nanba?"],[12,24,"Mir ging es mal ähnlich"]]