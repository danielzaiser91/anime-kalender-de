[[1,24,"Ein echter Held"],[2,24,"Bist du bereit?"],[3,24,"Ich habe Sie warte lassen, Mylady!"],[4,24,"Vater"],[5,24,"Familienbande"],[6,24,"Ausflug zur Quelle"],[7,24,"Werde mein"],[8,24,"Gib mir Mut"],[9,24,"Sturmangriff"],[10,24,"Werde, wer auch immer du sein willst"],[11,24,"Die Wege der Ritter"],[12,24,"Darum bin ich ein Ritter"]]