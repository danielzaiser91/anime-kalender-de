[[1,24,"Ja, eine erneute Masou-Verwandlung!"],[2,24,"Ah, Lebwohl, Ich"],[3,24,"Hi! Du bist das! Zuneigung!"],[4,24,"Nein, komm nach Hause, Meister"],[5,24,"Ja, das ist jedes Jahr beliebt."],[6,24,"Verdammt! Ich sollte gewinnen!"],[7,24,"Ja, Sensei ist der Stärkste!"],[8,24,"Hey, es ist Gokonzeit, Kyouko!"],[9,24,"Ah, mein nichtsnutziger Liebling"],[10,24,"Aber das ist schon in Ordnung"]]