{"f":[[1,"Ja, eine erneute Masou-Verwandlung!"],[2,"Ah, Lebwohl, Ich"],[3,"Hi! Du bist das! Zuneigung!"],[4,"Nein, komm nach Hause, Meister"],[5,"Ja, das ist jedes Jahr beliebt."],[6,"Verdammt! Ich sollte gewinnen!"],[7,"Ja, Sensei ist der Stärkste!"],[8,"Hey, es ist Gokonzeit, Kyouko!"],[9,"Ah, mein nichtsnutziger Liebling"],[10,"Aber das ist schon in Ordnung"]],"de":[],"min":24}