[[1,24,"Wir sehen uns nach der Schule!"],[2,24,"Sie sind alle Tiere!"],[3,24,"Spielen wir Bettler!"],[4,24,"Welches Zeichen ist sie?"],[5,24,"Ich habe mir etwas vorgemacht"],[6,24,"Wir sollten dir einmal einen Besuch abstatten"],[7,24,"Es wird Frühling"],[8,24,"Bis bald!"],[9,24,"Yuki war meine erste Liebe"],[10,24,"Es ist doch Valentinstag"],[11,24,"Was für eine hübsche Unterkunft!"],[12,24,"Du wirkst vergnügt"],[13,24,"Wie geht es dir, mein kleiner Bruder?"],[14,24,"Das ist ein Geheimnis"],[15,24,"Das würde ich nicht sagen"],[16,24,"Ihr sollt nicht drauf rumtrampeln!"],[17,24,"Das ist für Uo!"],[18,24,"Das Wichtigste ist…"],[19,24,"Es tut mir so leid!"],[20,24,"Du hast ihn echt aufgehoben"],[21,24,"Ich werde mich ihren Wellen stellen"],[22,24,"Ich war einfach glücklich"],[23,24,"Dir scheint es gut zu gehen…"],[24,24,"Gehen wir zurück"],[25,24,"Bald kommt der Sommer"]]