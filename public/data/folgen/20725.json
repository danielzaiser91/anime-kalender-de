[[1,24,"Ich spiel in jedem Spiel mit vollem Einsatz..."],[2,24,"Das ist meins!"],[3,24,"Komm mir nicht in die Quere!"],[4,24,"Ich werde sie tragen"],[5,24,"Ich wüsste von niemandem..."],[6,24,"Ich werde sie euch zum Geschenk machen"],[7,24,"Er ist so stark, dass ich lachen will."],[8,24,"Das wahre Licht"],[9,24,"Unterschätzt uns nicht!!"],[10,24,"Um zu gewinnen"],[11,24,"Dieses Mal"],[12,24,"Der beste Spieler"],[13,24,"Tiefblauer Himmel"],[14,24,"... Es tut mir leid"],[15,24,"Nicht mehr wie früher"],[16,24,"Was ist ein Sieg?"],[17,24,"Das Endspiel beginnt!!"],[18,24,"Ist das nicht das Beste?"],[19,24,"Es wird kein Wunder geschehen"],[20,24,"Das Gewicht der Entschlossenheit"],[21,24,"Es ist Verzweiflung"],[22,24,"Eine Warnung"],[23,24,"Warum gibst du nicht auf?"],[24,24,"Das warst in Wirklichkeit du"],[25,24,"So oft du möchtest"]]