{"f":[[1,"Ich spiel in jedem Spiel mit vollem Einsatz..."],[2,"Das ist meins!"],[3,"Komm mir nicht in die Quere!"],[4,"Ich werde sie tragen"],[5,"Ich wüsste von niemandem..."],[6,"Ich werde sie euch zum Geschenk machen"],[7,"Er ist so stark, dass ich lachen will."],[8,"Das wahre Licht"],[9,"Unterschätzt uns nicht!!"],[10,"Um zu gewinnen"],[11,"Dieses Mal"],[12,"Der beste Spieler"],[13,"Tiefblauer Himmel"],[14,"... Es tut mir leid"],[15,"Nicht mehr wie früher"],[16,"Was ist ein Sieg?"],[17,"Das Endspiel beginnt!!"],[18,"Ist das nicht das Beste?"],[19,"Es wird kein Wunder geschehen"],[20,"Das Gewicht der Entschlossenheit"],[21,"Es ist Verzweiflung"],[22,"Eine Warnung"],[23,"Warum gibst du nicht auf?"],[24,"Das warst in Wirklichkeit du"],[25,"So oft du möchtest"]],"de":[],"min":24}