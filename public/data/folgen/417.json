[[1,24,"Wozu hast du dieses Schwert"],[2,24,"Ich freu mich darauf Roan"],[3,24,"Ich glaube an sie"],[4,24,"Ist das deine eigene Kraft ?"],[5,24,"Was hast du gerade gesagt ?"],[6,24,"Denn ich lasse mich von niemandem davon abhalten"],[7,24,"Du willst mich trösten ?"],[8,24,"&quot;Unglücklich&quot; Wer den Wert des lebens nicht kennt"],[9,24,"Alles nur um der Warheit willen"],[10,24,"Du bist doch Keough ?"],[11,24,"Auf der Welt gibt es nur Verzweiflung"],[12,24,"Ich bin nicht gut genug"],[13,24,"Ein Beschützer"],[14,24,"Warum antwortet ihr mir nicht ?"],[15,24,"Keine Sorge ich bin bei euch"],[16,24,"Ich kann garnichts retten"],[17,24,"Auch du bist bereits befleckt"],[18,24,"Sie haben es alle gewusst"],[19,24,"Wir bleiben für immer zusammen"],[20,24,"Dann ist es mir egal..."],[21,24,"Ich brauche dich"],[22,24,"Wer von uns ist hier einsam ?"],[23,24,"Leb wohl,.."],[24,24,"Der Ort an dem alles enden wird"],[25,24,"Jemand der seine Fehler erkannt hat"],[26,24,"&quot;Finale&quot; Um unser aller Zukunft willen !"]]