[[1,24,"Ich werde erneut ein Festessen abhalten"],[2,24,"Das ist eine unabänderliche Tatsache"],[3,24,"Es soll schneien"],[4,24,"Ich bin wieder da…"],[5,24,"Du weißt es doch, oder?"],[6,24,"Wie dumm von dir"],[7,24,"Ja, es ist leer"],[8,24,"Ich bin enttäuscht von dir…"],[9,24,"Und wie heißt du?"],[10,24,"Ich liebe sie einfach…"],[11,24,"Leb wohl"],[12,24,"Du warst sehr stark"],[13,24,"Bis bald"]]