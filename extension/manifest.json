{
  "manifest_version": 3,
  "name": "Anime-Kalender: Synchro melden",
  "description": "Meldet bei Netflix, Amazon, Disney+ und ADN die Tonspuren der Titel, deren deutsche Synchro im Anime-Kalender noch offen ist. Bei allen anderen Seiten bleibt sie still.",
  "version": "4.31.10",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://newsletter.animekalender.workers.dev/*",
    "https://anime-kalender.de/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "exclude_matches": [
        "https://www.netflix.com/tudum/*"
      ],
      "js": [
        "leser.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "exclude_matches": [
        "https://www.netflix.com/tudum/*"
      ],
      "js": [
        "netflix-stumm.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "exclude_matches": [
        "https://www.netflix.com/tudum/*"
      ],
      "js": [
        "tageslimit.js",
        "box.js",
        "offene-netflix.js",
        "pruefstand-zeit.js",
        "protokoll.js",
        "disney-netz.js",
        "netflix-gemeldet.js",
        "netflix-durchgang-schutz.js",
        "netflix-uebernahme.js",
        "netflix-randvoll.js",
        "netflix-erinnern.js",
        "netflix-zurueckgestellt.js",
        "netflix-alle-staffeln.js",
        "melder.js",
        "netflix-bericht.js",
        "netflix-protokoll.js"
      ],
      "css": [
        "melder.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.de/*"
      ],
      "js": [
        "ruhig.js"
      ],
      "css": [
        "melder.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.amazon.de/*"
      ],
      "js": [
        "amazon-leser.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.amazon.de/*"
      ],
      "js": [
        "tageslimit.js",
        "box.js",
        "melde-sperre.js",
        "offene-amazon.js",
        "offene-amazon-stand.js",
        "offene-amazon-suche.js",
        "prime-titelseite.js",
        "prime-stand.js",
        "prime-such-bruecke.js",
        "amazon.js"
      ],
      "css": [
        "melder.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.disneyplus.com/*"
      ],
      "js": [
        "disney-leser.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.disneyplus.com/*"
      ],
      "js": [
        "tageslimit.js",
        "box.js",
        "melde-sperre.js",
        "offene-disney.js",
        "pruefstand-zeit.js",
        "disney-netz.js",
        "disney-staffeln.js",
        "disney-beantwortet.js",
        "disney-weg.js",
        "disney.js",
        "disney-durchgang.js"
      ],
      "css": [
        "melder.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://animationdigitalnetwork.com/*"
      ],
      "js": [
        "tageslimit.js",
        "box.js",
        "melde-sperre.js",
        "disney-netz.js",
        "adn-leser.js",
        "adn-senden.js",
        "adn.js"
      ],
      "css": [
        "melder.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "optionen.html",
    "open_in_tab": true
  }
}
