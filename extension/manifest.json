{
  "manifest_version": 3,
  "name": "Anime-Kalender: Synchro melden",
  "description": "Meldet bei Netflix, Amazon und Disney+ die Tonspuren der Titel, deren deutsche Synchro im Anime-Kalender noch offen ist. Bei allen anderen Seiten bleibt sie still.",
  "version": "4.24.11",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://newsletter.animekalender.workers.dev/*",
    "https://anime-kalender.de/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "exclude_matches": [
        "https://www.netflix.com/tudum/*"
      ],
      "js": [
        "leser.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "exclude_matches": [
        "https://www.netflix.com/tudum/*"
      ],
      "js": [
        "box.js",
        "offene-netflix.js",
        "melder.js"
      ],
      "css": [
        "melder.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.de/*"
      ],
      "js": [
        "ruhig.js"
      ],
      "css": [
        "melder.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.amazon.de/*"
      ],
      "js": [
        "amazon-leser.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.amazon.de/*"
      ],
      "js": [
        "box.js",
        "offene-amazon.js",
        "offene-amazon-stand.js",
        "offene-amazon-suche.js",
        "amazon.js"
      ],
      "css": [
        "melder.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.disneyplus.com/*"
      ],
      "js": [
        "disney-leser.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.disneyplus.com/*"
      ],
      "js": [
        "box.js",
        "offene-disney.js",
        "pruefstand-zeit.js",
        "disney-staffeln.js",
        "disney.js",
        "disney-durchgang.js"
      ],
      "css": [
        "melder.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "optionen.html",
    "open_in_tab": true
  }
}
