{
  "manifest_version": 3,
  "name": "Anime-Kalender: Synchro melden",
  "description": "Blendet bei Netflix, Crunchyroll und Prime Video einen Knopf ein, der die vorhandenen Tonspuren an den Anime-Kalender meldet.",
  "version": "0.10.0",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://newsletter.animekalender.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.crunchyroll.com/*",
        "https://www.amazon.de/*"
      ],
      "js": [
        "leser.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.crunchyroll.com/*",
        "https://www.amazon.de/*"
      ],
      "js": [
        "melder.js"
      ],
      "css": [
        "melder.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "optionen.html",
    "open_in_tab": true
  }
}
