{
  "name": "anime-kalender-newsletter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "db:init": "wrangler d1 execute anime-kalender --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute anime-kalender --remote --file=./schema.sql",
    "tail": "wrangler tail --config wrangler.toml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.16.0"
  }
}
