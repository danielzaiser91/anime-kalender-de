{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["web/src/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["web/src", "web/buehne", "pipeline", "shared", "tools", "vite.config.ts", "vite.buehne.config.ts"],
  // Ausschlüsse dürfen nur sinken. claude-global: Modul `claude-code` liegt nicht im Repo (eigene Typen im Plugin).
  // Worker-Messwerkzeuge und -Tests: brauchen Workers-Typen, geprüft in tools/tsconfig.worker.json (check:worker).
  "exclude": ["tools/claude-global", "tools/worker-*.ts", "tools/titelzeile-einspielen*.ts", "tools/newsletter-probe.ts"]
}
