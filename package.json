{
  "name": "anime-kalender-de",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Wochenkalender für alle Anime-Releases mit deutscher Synchronisation",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "data:fetch": "tsx pipeline/fetch.ts",
    "data:crunchyroll": "tsx pipeline/scrape-crunchyroll.ts --weeks 8",
    "data:build": "tsx pipeline/build.ts",
    "data:all": "npm run data:fetch && npm run data:crunchyroll && npm run data:build",
    "data:validate": "tsx pipeline/validate.ts",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -b"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "js-yaml": "^4.1.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
