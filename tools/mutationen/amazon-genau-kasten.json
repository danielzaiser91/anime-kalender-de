[
  { "name": "Kontrolle (unmutiert)", "aenderungen": [], "tests": ["node extension/amazon-genau-kasten.test.cjs"] },
  { "name": "Aufruf entfernt", "aenderungen": [{ "datei": "extension/amazon.js", "suche": "if (befund.art === 'genau') return genauZeigen(auftrag, zeichnen, befund, begriffZeile, folgen)", "ersetze": "if (befund.art === 'genau') return" }], "tests": ["node extension/amazon-genau-kasten.test.cjs"] },
  { "name": "Argumente vertauscht", "aenderungen": [{ "datei": "extension/amazon.js", "suche": "if (befund.art === 'genau') return genauZeigen(auftrag, zeichnen, befund, begriffZeile, folgen)", "ersetze": "if (befund.art === 'genau') return genauZeigen(auftrag, zeichnen, befund, folgen, begriffZeile)" }], "tests": ["node extension/amazon-genau-kasten.test.cjs"] },
  { "name": "Sortierung umgekehrt", "aenderungen": [{ "datei": "extension/amazon.js", "suche": "Number(kanalKarte(a)) - Number(kanalKarte(b))", "ersetze": "Number(kanalKarte(b)) - Number(kanalKarte(a))" }], "tests": ["node extension/amazon-genau-kasten.test.cjs"] },
  { "name": "Kanal nie erkannt", "aenderungen": [{ "datei": "extension/amazon.js", "suche": "const kanalKarte = (k) => /channel|subscription/i.test(String(k.zugang ?? ''))", "ersetze": "const kanalKarte = (k) => false" }], "tests": ["node extension/amazon-genau-kasten.test.cjs"] },
  { "name": "weitere ab der ersten Karte", "aenderungen": [{ "datei": "extension/amazon.js", "suche": ".slice(1, 4)", "ersetze": ".slice(0, 4)" }], "tests": ["node extension/amazon-genau-kasten.test.cjs"] },
  { "name": "weitere nicht gemerkt", "aenderungen": [{ "datei": "extension/amazon.js", "suche": "if (weitereAusgaben.length) {", "ersetze": "if (false) {" }], "tests": ["node extension/amazon-genau-kasten.test.cjs"] },
  { "name": "weitere immer gemerkt", "aenderungen": [{ "datei": "extension/amazon.js", "suche": "if (weitereAusgaben.length) {", "ersetze": "if (true) {" }], "tests": ["node extension/amazon-genau-kasten.test.cjs"] },
  { "name": "zielAsin nicht gemerkt", "aenderungen": [{ "datei": "extension/amazon.js", "suche": "suchauftragMerken({ ...auftrag, suchUrl: auftrag.suchUrl, zielAsin: zielKennung })", "ersetze": "" }], "tests": ["node extension/amazon-genau-kasten.test.cjs"] },
  { "name": "Sprungknopf auch bei zwei Karten", "aenderungen": [{ "datei": "extension/amazon.js", "suche": "sortiert.length < 2 && ziel", "ersetze": "sortiert.length < 3 && ziel" }], "tests": ["node extension/amazon-genau-kasten.test.cjs"] },
  { "name": "Sprungknopf nie", "aenderungen": [{ "datei": "extension/amazon.js", "suche": "sortiert.length < 2 && ziel", "ersetze": "sortiert.length < 1 && ziel" }], "tests": ["node extension/amazon-genau-kasten.test.cjs"] },
  { "name": "Sprung mit Parametern", "aenderungen": [{ "datei": "extension/amazon.js", "suche": "location.href = ziel", "ersetze": "location.href = t.url", "nr": 2 }], "tests": ["node extension/amazon-genau-kasten.test.cjs"] },
  { "name": "Auswahl entfernt", "aenderungen": [{ "datei": "extension/amazon.js", "suche": "...erwartungsAuswahl(auftrag, sortiert),", "ersetze": "" }], "tests": ["node extension/amazon-genau-kasten.test.cjs"] },
  { "name": "Meldeknopf ohne Neuzeichnen", "aenderungen": [{ "datei": "extension/amazon.js", "suche": "nichtBeiPrimeMelden(auftrag, befund, k, zeichnen)", "ersetze": "nichtBeiPrimeMelden(auftrag, befund, k)", "nr": 2 }], "tests": ["node extension/amazon-genau-kasten.test.cjs"] },
  { "name": "gemeldet nie erkannt", "aenderungen": [{ "datei": "extension/amazon.js", "suche": "istGemeldet(auftrag.suchUrl)", "ersetze": "false", "nr": 7 }], "tests": ["node extension/amazon-genau-kasten.test.cjs"] },
  { "name": "Zusatz-Aufruf entfernt", "aenderungen": [{ "datei": "extension/amazon.js", "suche": "...genauZusatz(auftrag, befund, zeichnen, sortiert, t, ziel, zielKennung),", "ersetze": "" }], "tests": ["node extension/amazon-genau-kasten.test.cjs"] }
