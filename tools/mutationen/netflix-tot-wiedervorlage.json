  { "name": "Eintrag: Ablauf sofort", "aenderungen": [{ "datei": "extension/netflix-zurueckgestellt.js", "suche": "bis: zurueckBis(grund, null, jetzt), am: jetzt }", "ersetze": "bis: jetzt, am: jetzt }" }], "tests": ["node extension/netflix-nicht-da.test.cjs"] },
