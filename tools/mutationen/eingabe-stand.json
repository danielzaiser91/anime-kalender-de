  {
    "name": "findeRueckschritte: < zu <= (Gleichstand wäre Befund)",
    "aenderungen": [
      {
        "datei": "pipeline/lib/eingabe-stand.ts",
        "suche": "Date.parse(jetzt) < Date.parse(vorher)",
        "ersetze": "Date.parse(jetzt) <= Date.parse(vorher)"
      }
    ]
  },
  {
