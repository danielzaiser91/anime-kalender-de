[
  { "name": "Kontrolle (unmutiert)", "aenderungen": [], "tests": ["node tools/pr-pruefer-ablauf.test.mjs"] },
  { "name": "wdh: nur zwei Versuche", "aenderungen": [{ "datei": ".github/workflows/pr-pruefer.yml", "suche": "for i in 1 2 3; do", "ersetze": "for i in 1 2; do" }], "tests": ["node tools/pr-pruefer-ablauf.test.mjs"] },
  { "name": "wdh: Autor-Abruf ohne Wiederholung", "aenderungen": [{ "datei": ".github/workflows/pr-pruefer.yml", "suche": "autor=$(wdh gh api", "ersetze": "autor=$(gh api" }], "tests": ["node tools/pr-pruefer-ablauf.test.mjs"] },
  { "name": "wdh: Dateiliste ohne Wiederholung", "aenderungen": [{ "datei": ".github/workflows/pr-pruefer.yml", "suche": "if wdh gh api --method GET --paginate", "ersetze": "if gh api --method GET --paginate" }], "tests": ["node tools/pr-pruefer-ablauf.test.mjs"] },
  { "name": "wdh: Ausgabe des erfolgreichen Versuchs geht verloren", "aenderungen": [{ "datei": ".github/workflows/pr-pruefer.yml", "suche": "then cat \"$t\"; rm -f \"$t\"; return 0; fi", "ersetze": "then rm -f \"$t\"; return 0; fi" }], "tests": ["node tools/pr-pruefer-ablauf.test.mjs"] },
  { "name": "wdh: nach dem dritten Fehlschlag Erfolg gemeldet", "aenderungen": [{ "datei": ".github/workflows/pr-pruefer.yml", "suche": "rm -f \"$t\"; return 1", "ersetze": "rm -f \"$t\"; return 0" }], "tests": ["node tools/pr-pruefer-ablauf.test.mjs"] },
  { "name": "Freigabe: unvollstaendig ergibt Approve", "aenderungen": [{ "datei": ".github/workflows/pr-pruefer.yml", "suche": "art=unvollstaendig", "ersetze": "art=ok" }, { "datei": "tools/pr-pruefer.schnappschuss.json", "suche": "art=unvollstaendig", "ersetze": "art=ok" }], "tests": ["node tools/pr-pruefer-freigabe.test.mjs"] },
  { "name": "Freigabe: unvollstaendig ergibt wieder aendern", "aenderungen": [{ "datei": ".github/workflows/pr-pruefer.yml", "suche": "art=unvollstaendig", "ersetze": "art=aendern" }, { "datei": "tools/pr-pruefer.schnappschuss.json", "suche": "art=unvollstaendig", "ersetze": "art=aendern" }], "tests": ["node tools/pr-pruefer-freigabe.test.mjs"] },
  { "name": "Neustart: Grenze start <= kommentar zu start < kommentar", "aenderungen": [{ "datei": "tools/pr-pruefer-neustart.mjs", "suche": "start <= kommentar", "ersetze": "start < kommentar" }], "tests": ["node tools/pr-pruefer-neustart.test.mjs"] },
  { "name": "Neustart: abgeschlossener Lauf zählt immer als gelesen", "aenderungen": [{ "datei": "tools/pr-pruefer-neustart.mjs", "suche": "|| lauf.conclusion === 'success'", "ersetze": "|| true" }], "tests": ["node tools/pr-pruefer-neustart.test.mjs"] },
  { "name": "Neustart: laufender Lauf zählt nie als gelesen", "aenderungen": [{ "datei": "tools/pr-pruefer-neustart.mjs", "suche": "return lauf.status !== 'completed' ||", "ersetze": "return false ||" }], "tests": ["node tools/pr-pruefer-neustart.test.mjs"] },
  { "name": "Neustart: Laufzeit nicht geprüft", "aenderungen": [{ "datei": "tools/pr-pruefer-neustart.mjs", "suche": "|| !Number.isFinite(start)", "ersetze": "" }], "tests": ["node tools/pr-pruefer-neustart.test.mjs"] },
  { "name": "Neustart: Kommentarzeit nicht geprüft", "aenderungen": [{ "datei": "tools/pr-pruefer-neustart.mjs", "suche": "!Number.isFinite(kommentar) ||", "ersetze": "" }], "tests": ["node tools/pr-pruefer-neustart.test.mjs"] },
  { "name": "Neustart: Aufruf in main entfernt", "aenderungen": [{ "datei": "tools/pr-pruefer-neustart.mjs", "suche": "if (liestKommentarSchon(lauf, env.KOMMENTAR_ZEIT))", "ersetze": "if (false && liestKommentarSchon(lauf, env.KOMMENTAR_ZEIT))" }], "tests": ["node tools/pr-pruefer-neustart.test.mjs"] },
  { "name": "Neustart: falscher env-Name in main", "aenderungen": [{ "datei": "tools/pr-pruefer-neustart.mjs", "suche": "liestKommentarSchon(lauf, env.KOMMENTAR_ZEIT))", "ersetze": "liestKommentarSchon(lauf, env.KOMMENTAR))" }], "tests": ["node tools/pr-pruefer-neustart.test.mjs"] },
  { "name": "Neustart: YAML reicht die Zeit nicht durch", "aenderungen": [{ "datei": ".github/workflows/pr-pruefer-nachtrag.yml", "suche": "KOMMENTAR_ZEIT: ${{", "ersetze": "KOMMENTAR_ZEIT_X: ${{" }], "tests": ["node tools/pr-pruefer-neustart.test.mjs"] }
]
