  { "name": "zweig: Text auf 119 Zeichen", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "const zeile = `PR ${nummer}: update-branch abgewiesen (HTTP ${status[1]}: ${text.split('\\n')[0].slice(0, 120)})", "ersetze": "const zeile = `PR ${nummer}: update-branch abgewiesen (HTTP ${status[1]}: ${text.split('\\n')[0].slice(0, 119)})" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
