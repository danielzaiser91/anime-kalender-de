  { "name": "zweig: Lesefehler nach unklarem PUT ohne Ungewissheit", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "throw new Error(`${ungewiss}; Kopf nicht lesbar (${String(e.message).split('\\n')[0]})`)", "ersetze": "throw e" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
