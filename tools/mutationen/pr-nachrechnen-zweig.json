  { "name": "nachrechnen: Rückfall nie", "aenderungen": [{ "datei": "tools/pr-nachrechnen.mjs", "suche": "  if (neuerKopf !== null) {", "ersetze": "  if (true) {" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "nachrechnen: Meldung ohne neuen Kopf", "aenderungen": [{ "datei": "tools/pr-nachrechnen.mjs", "suche": "neuer Kopf ${neuerKopf}: Kette abwarten", "ersetze": "neuer Kopf ${kurz(neuerKopf)}: Kette abwarten" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
