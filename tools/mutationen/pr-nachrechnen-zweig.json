  { "name": "zweig: nur 403 gilt als abgewiesen (422 unklar)", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "/HTTP 4\\d\\d/", "ersetze": "/HTTP 403/" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: 5xx gilt als nichts angestoßen (Rückfall nach Wirkung)", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "/HTTP 4\\d\\d/", "ersetze": "/HTTP [45]\\d\\d/" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
