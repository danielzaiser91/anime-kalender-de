  { "name": "zweig: Prüfgrenze 16", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "KOPF_PRUEFUNGEN = 15", "ersetze": "KOPF_PRUEFUNGEN = 16" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
