[
  { "name": "Kontrolle (unmutiert)", "aenderungen": [], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "nachrechnen: update-branch nicht aufgerufen (alter Weg)", "aenderungen": [{ "datei": "tools/pr-nachrechnen.mjs", "suche": "const neuerKopf = aktualisiereZweig(gh, nummer, pr.headRefOid, warte)", "ersetze": "const neuerKopf = null" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "nachrechnen: Rückfall immer, auch nach update-branch", "aenderungen": [{ "datei": "tools/pr-nachrechnen.mjs", "suche": "if (neuerKopf === null) anstossen(", "ersetze": "if (neuerKopf !== undefined) anstossen(" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "nachrechnen: Rückfall nie", "aenderungen": [{ "datei": "tools/pr-nachrechnen.mjs", "suche": "if (neuerKopf === null) anstossen(", "ersetze": "if (false) anstossen(" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "nachrechnen: Meldung ohne neuen Kopf", "aenderungen": [{ "datei": "tools/pr-nachrechnen.mjs", "suche": "neuer Kopf ${neuerKopf}: Nachtrag", "ersetze": "neuer Kopf ${kurz(neuerKopf)}: Nachtrag" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: expected_head_sha falsch", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "`expected_head_sha=${kopf}`", "ersetze": "`expected_head_sha=${nummer}`" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: Methode GET statt PUT", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "'-X', 'PUT'", "ersetze": "'-X', 'GET'" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: Pfad ohne update-branch", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "/update-branch`", "ersetze": "/merge`" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: 4xx-Abweisung gilt als unklar (kein Rückfall)", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "if (NICHT_ANGESTOSSEN.test(text)) return null", "ersetze": "if (false) return null" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: nur 422 gilt als abgewiesen (403 unklar)", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "/HTTP 4\\d\\d|^Trockenlauf|Höchstmenge/", "ersetze": "/HTTP 422|^Trockenlauf|Höchstmenge/" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: nur 403 gilt als abgewiesen (422 unklar)", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "/HTTP 4\\d\\d|^Trockenlauf|Höchstmenge/", "ersetze": "/HTTP 403|^Trockenlauf|Höchstmenge/" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: 5xx gilt als nichts angestoßen (Rückfall nach Wirkung)", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "/HTTP 4\\d\\d|^Trockenlauf|Höchstmenge/", "ersetze": "/HTTP [45]\\d\\d|^Trockenlauf|Höchstmenge/" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: Kopf-Nachlesen im catch entfernt", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "    return nachUnklaremPut(gh, nummer, kopf, text)\n", "ersetze": "    return null\n" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: unklarer PUT mit altem Kopf zählt als neu", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "if (neu === '' || neu === kopf) throw new Error(ungewiss)", "ersetze": "if (neu === '') throw new Error(ungewiss)" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: unklarer PUT mit leerem Kopf zählt als neu", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "if (neu === '' || neu === kopf) throw new Error(ungewiss)", "ersetze": "if (neu === kopf) throw new Error(ungewiss)" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: Lesefehler nach unklarem PUT ohne Ungewissheit", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "throw new Error(`${ungewiss}; Kopf nicht lesbar (${String(e.message).split('\\n')[0]})`)", "ersetze": "throw e" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: Lesefehler nach angenommenem PUT ohne SCHON ANGESTOSSEN", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "throw new Error(`PR ${nummer}: update-branch angenommen, Kopf nicht lesbar (${String(e.message).split('\\n')[0]}): SCHON ANGESTOSSEN, Kopf später prüfen, nicht blind wiederholen`)", "ersetze": "throw e" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: Kopf nicht abgewartet (alter Kopf zählt als neu)", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "if (neu !== '' && neu !== kopf) return neu", "ersetze": "if (neu !== '') return neu" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: leerer Kopf zählt als neu", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "if (neu !== '' && neu !== kopf) return neu", "ersetze": "if (neu !== kopf) return neu" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: Prüfgrenze 14", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "KOPF_PRUEFUNGEN = 15", "ersetze": "KOPF_PRUEFUNGEN = 14" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: Prüfgrenze 16", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "KOPF_PRUEFUNGEN = 15", "ersetze": "KOPF_PRUEFUNGEN = 16" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: Abstand 1999", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "KOPF_ABSTAND_MS = 2000", "ersetze": "KOPF_ABSTAND_MS = 1999" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: Kein Warten", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "    warte(KOPF_ABSTAND_MS)\n", "ersetze": "" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: Zeitüberschreitung ohne SCHON ANGESTOSSEN", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "(SCHON ANGESTOSSEN: später Kopf prüfen", "ersetze": "(später Kopf prüfen" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] }
