[
  { "name": "Kontrolle (unmutiert)", "aenderungen": [], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "nachrechnen: update-branch nicht aufgerufen (alter Weg)", "aenderungen": [{ "datei": "tools/pr-nachrechnen.mjs", "suche": "const neuerKopf = aktualisiereZweig(gh, nummer, pr.headRefOid, warte)", "ersetze": "const neuerKopf = null" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "nachrechnen: Rückfall immer, auch nach update-branch", "aenderungen": [{ "datei": "tools/pr-nachrechnen.mjs", "suche": "if (neuerKopf === null) anstossen(", "ersetze": "if (neuerKopf !== undefined) anstossen(" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "nachrechnen: Rückfall nie", "aenderungen": [{ "datei": "tools/pr-nachrechnen.mjs", "suche": "if (neuerKopf === null) anstossen(", "ersetze": "if (false) anstossen(" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "nachrechnen: Meldung ohne neuen Kopf", "aenderungen": [{ "datei": "tools/pr-nachrechnen.mjs", "suche": "neuer Kopf ${neuerKopf}: Nachtrag", "ersetze": "neuer Kopf ${kurz(neuerKopf)}: Nachtrag" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: expected_head_sha falsch", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "`expected_head_sha=${kopf}`", "ersetze": "`expected_head_sha=${nummer}`" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: Methode GET statt PUT", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "'-X', 'PUT'", "ersetze": "'-X', 'GET'" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: Pfad ohne update-branch", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "/update-branch`", "ersetze": "/merge`" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: 422 fällt auf Rückfall", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "if (/\\b422\\b/.test(text)) throw", "ersetze": "if (false) throw" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: Zeitlimit fällt auf Rückfall", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "if (text.startsWith('FEHLER:')) throw", "ersetze": "if (false) throw" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: anderer Fehler wirft statt Rückfall", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "    return null\n  }\n  for", "ersetze": "    throw e\n  }\n  for" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: Kopf nicht abgewartet (alter Kopf zählt als neu)", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "if (neu !== '' && neu !== kopf) return neu", "ersetze": "if (neu !== '') return neu" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
  { "name": "zweig: leerer Kopf zählt als neu", "aenderungen": [{ "datei": "tools/pr-nachrechnen-zweig.mjs", "suche": "if (neu !== '' && neu !== kopf) return neu", "ersetze": "if (neu !== kopf) return neu" }], "tests": ["node tools/pr-nachrechnen.test.mjs"] },
