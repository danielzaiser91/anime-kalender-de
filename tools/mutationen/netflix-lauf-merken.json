    "node --require ./extension/test-kontext.cjs extension/netflix-durchgang-fortschritt.test.cjs"
   ]
  },
  {
   "name": "melder: fertigeTitel nur im Arbeitsspeicher",
   "aenderungen": [
    {
     "datei": "extension/melder.js",
     "suche": "const fertigeTitel = akNetflixFertigSet()",
     "ersetze": "const fertigeTitel = new Set()"
    }
   ],
   "tests": [
    "node --require ./extension/test-kontext.cjs extension/netflix-zurueckgestellt.test.cjs"
   ]
  },
  {
   "name": "Fertig-Set: add schreibt nicht",
   "aenderungen": [
    {
     "datei": "extension/netflix-durchgang-steuerung.js",
